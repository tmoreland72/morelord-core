<section class="ml-app ml-stack" data-gap="4" aria-label="Morelord design system fixture">
  <header class="ml-hero">
    <div class="ml-hero__body"><h1>Morelord UI</h1><p>Development-only visual fixture.</p></div>
    <button type="button" class="ml-icon-button" aria-label="Refresh fixture"><i class="fa-solid fa-rotate"></i></button>
  </header>
  <div class="ml-grid" data-columns="2">
    <article class="ml-surface ml-stack">
      <h2>Statuses</h2>
      <span class="ml-status" data-tone="success">Success</span>
      <span class="ml-status" data-tone="warning">Warning</span>
      <span class="ml-status" data-tone="danger">Error</span>
      <span class="ml-badge" data-tone="premium">Premium</span>
    </article>
    <article class="ml-access-card" data-state="active">
      <div class="ml-access-card__icon"><i class="fa-solid fa-crown"></i></div>
      <div class="ml-access-card__body"><strong>Premium access</strong><small>Shared account state.</small></div>
      <div class="ml-access-card__actions"><button type="button">Manage</button></div>
    </article>
  </div>
  <div class="ml-empty-state ml-surface"><i class="fa-solid fa-box-open"></i><h3>Nothing here yet</h3><p>Empty-state supporting text.</p></div>
</section>
