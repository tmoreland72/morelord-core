<div class="ml-app ml-location-manager__layout">
  <aside class="ml-location-manager__sidebar ml-stack" data-gap="2">
    <div class="ml-cluster ml-location-manager__sidebar-heading">
      <h2><i class="fa-solid fa-map-location-dot"></i> Locations</h2>
      <button type="button" class="ml-button ml-button--icon" data-action="create" title="Create Location" aria-label="Create Location">
        <i class="fa-solid fa-plus"></i>
      </button>
    </div>
    {{#if hasLocations}}
      <nav class="ml-location-manager__list" aria-label="Morelord Locations">
        {{#each locations}}
          <button type="button" class="ml-location-manager__location {{#if selected}}is-active{{/if}}" data-action="edit" data-location-id="{{id}}">
            <strong>{{name}}</strong>
            <small>{{settlementType}}</small>
          </button>
        {{/each}}
      </nav>
    {{else}}
      <div class="ml-empty-state">
        <i class="fa-solid fa-map"></i>
        <p>No shared locations yet.</p>
      </div>
    {{/if}}
  </aside>

  <main class="ml-location-manager__editor ml-stack" data-gap="4">
    {{#if draft}}
      <header class="ml-hero">
        <div class="ml-hero__body">
          <h2>{{#if isExisting}}Edit Location{{else}}New Location{{/if}}</h2>
          <p>Locations are shared by Journeys, Craftworks, Marketplace, and Downtime.</p>
        </div>
      </header>

      <section class="ml-surface ml-stack" data-gap="3">
        <div class="ml-location-manager__fields">
          <label class="ml-stack" data-gap="1">
            <span>Name</span>
            <input type="text" name="name" value="{{draft.name}}" required placeholder="Neverwinter">
          </label>
          <label class="ml-stack" data-gap="1">
            <span>Settlement Type</span>
            <select name="settlementType">{{selectOptions settlementTypes selected=draft.settlementType}}</select>
          </label>
        </div>
        <label class="ml-stack" data-gap="1">
          <span>Notes</span>
          <textarea name="notes" rows="3" placeholder="GM-facing location notes">{{draft.notes}}</textarea>
        </label>
      </section>

      <section class="ml-surface ml-stack" data-gap="3">
        <div class="ml-cluster ml-location-manager__section-heading">
          <div>
            <h3><i class="fa-solid fa-screwdriver-wrench"></i> Capabilities</h3>
            <p>Capability tier is independent from settlement size.</p>
          </div>
          <button type="button" data-action="addCapability"><i class="fa-solid fa-plus"></i> Add Capability</button>
        </div>
        <input type="hidden" name="capabilityCount" value="{{draft.capabilities.length}}">
        {{#each draft.capabilities}}
          <div class="ml-location-manager__capability">
            <label><span>Type</span><select name="capabilities.{{@index}}.type">{{selectOptions ../capabilityTypes selected=type}}</select></label>
            <label><span>Tier</span><select name="capabilities.{{@index}}.tier">{{selectOptions ../capabilityTiers selected=tier}}</select></label>
            <label><span>Specialty</span><input type="text" name="capabilities.{{@index}}.specialty" value="{{specialty}}" placeholder="Optional"></label>
            <label><span>Source</span><input type="text" name="capabilities.{{@index}}.source" value="{{source}}" placeholder="Optional"></label>
            <button type="button" class="ml-button ml-button--icon" data-tone="danger" data-action="removeCapability" data-index="{{@index}}" title="Remove Capability" aria-label="Remove Capability"><i class="fa-solid fa-trash"></i></button>
          </div>
        {{else}}
          <p class="notes">This location currently provides no registered capabilities.</p>
        {{/each}}
      </section>

      <section class="ml-surface ml-stack" data-gap="3">
        <div>
          <h3><i class="fa-solid fa-image"></i> Associated Scenes</h3>
          <p>When one of these Scenes is active, it resolves to this Morelord Location.</p>
        </div>
        {{#if scenes.length}}
          <div class="ml-location-manager__scene-picker ml-stack" data-gap="2">
            <label><span>Filter Scenes</span><input type="search" data-scene-filter placeholder="Type any part of a Scene name" autocomplete="off"></label>
            <select name="sceneIds" data-scene-select multiple size="12" aria-label="Associated Scenes">
              {{#each scenes}}<option value="{{id}}" {{#if selected}}selected="selected"{{/if}}>{{name}}</option>{{/each}}
            </select>
            <small><span data-scene-count></span> · Click a Scene to toggle its selection.</small>
          </div>
        {{else}}<p class="notes">This world has no Scenes.</p>{{/if}}
      </section>

      <footer class="ml-actions">
        <button type="button" data-action="save"><i class="fa-solid fa-floppy-disk"></i> Save Location</button>
        {{#if isExisting}}<button type="button" class="ml-button" data-tone="danger" data-action="delete"><i class="fa-solid fa-trash"></i> Delete</button>{{/if}}
      </footer>
    {{else}}
      <div class="ml-empty-state ml-location-manager__welcome">
        <i class="fa-solid fa-map-location-dot"></i>
        <h2>Shared Morelord Locations</h2>
        <p>Create a location to define its settlement type, capabilities, and associated Scenes.</p>
        <button type="button" data-action="create"><i class="fa-solid fa-plus"></i> Create First Location</button>
      </div>
    {{/if}}
  </main>
</div>
