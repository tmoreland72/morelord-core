<div class="ml-app ml-app-shell ml-core-account ml-stack" data-gap="4">
  <header class="ml-hero">
    <i class="fa-solid fa-link ml-hero__icon"></i>
    <div class="ml-hero__body">
      <h1>Morelord Core</h1>
      <p>Shared premium access for Morelord Tools modules.</p>
    </div>
    <div class="ml-actions"><button type="button" data-action="openDocumentation"><i class="fa-solid fa-book-open"></i> Documentation</button></div>
  </header>

  {{#if connected}}
    <section class="ml-surface ml-stack">
      <div class="ml-status" data-tone="success"><i class="fa-solid fa-circle-check"></i> Connected</div>
      <dl class="ml-core-account__details">
        <dt>Installation</dt><dd>{{connectionLabel}}</dd>
        <dt>Membership</dt><dd class="ml-core-account__tier">{{tier}}</dd>
        <dt>Last validated</dt><dd>{{validatedAt}}</dd>
        <dt>Offline access through</dt><dd>{{expiresAt}}</dd>
      </dl>
      <div class="ml-actions">
        <button type="button" data-action="refresh"><i class="fa-solid fa-rotate"></i> Refresh Access</button>
        <button type="button" data-action="openAccount"><i class="fa-solid fa-arrow-up-right-from-square"></i> Open Account</button>
        <button type="button" class="ml-button" data-tone="danger" data-action="disconnect"><i class="fa-solid fa-link-slash"></i> Disconnect</button>
      </div>
    </section>
  {{else}}
    <section class="ml-surface ml-stack">
      {{#if activation}}
        <div class="ml-status" data-tone="warning"><i class="fa-solid fa-hourglass-half"></i> Waiting for website approval</div>
        <div class="ml-surface ml-stack ml-core-account__steps" data-gap="1">
          <p><strong>1.</strong> The Morelord account page was opened in your browser.</p>
          <p><strong>2.</strong> Confirm that the code below matches the prefilled code on that page.</p>
          <p><strong>3.</strong> Select <em>Approve Foundry Connection</em>, then return here.</p>
        </div>
        <div class="ml-core-account__code">{{activation.userCode}}</div>
        <p class="notes">Foundry is checking for approval automatically. This code expires in 15 minutes.</p>
        <button type="button" data-action="openAccount"><i class="fa-solid fa-arrow-up-right-from-square"></i> Reopen Approval Page</button>
      {{else}}
        <div class="ml-status"><i class="fa-solid fa-link"></i> Not connected</div>
        <p>Connect once to unlock premium features across supported Morelord Tools modules in this world.</p>
        <button type="button" data-action="connect"><i class="fa-solid fa-crown"></i> Connect Morelord Account</button>
      {{/if}}
    </section>
  {{/if}}

  <section class="ml-surface ml-stack">
    <div class="ml-section-heading">
      <div>
        <h2><i class="fa-solid fa-gear"></i> Core Settings</h2>
        <p>Connection and privacy settings shared by Morelord modules.</p>
      </div>
    </div>
    <label class="ml-stack" data-gap="1">
      <span>Morelord Gaming Website</span>
      <input type="url" name="serverUrl" value="{{serverUrl}}" required>
      <small>Website used for account activation and entitlement checks.</small>
    </label>
    <div class="ml-stack" data-gap="1">
      <label class="ml-check">
        <input type="checkbox" name="shareUsageStatistics" aria-describedby="ml-core-version-sharing-help" {{checked shareUsageStatistics}}>
        <span>Share feature usage</span>
      </label>
      <small id="ml-core-version-sharing-help">Selected by default in the one-time GM notice; previous opt-outs are preserved. Save to apply your choice, and turn off here anytime. Shares feature actions, active module versions, Foundry and system versions, and GM/player role. A random world reporting ID makes reports pseudonymous. No account connection required; no campaign content is sent.</small>
    </div>
    <div class="ml-stack" data-gap="1">
      <label class="ml-check">
        <input type="checkbox" name="shareErrorReports" aria-describedby="ml-core-error-sharing-help" {{checked shareErrorReports}}>
        <span>Share error reports</span>
      </label>
      <small id="ml-core-error-sharing-help">Shares error types, Morelord code locations, failed operations and versions using the same random reporting ID. Recent feature actions are included only when feature sharing is enabled. Custom error text, campaign content and account credentials are excluded. Developer Mode pauses both reports.</small>
    </div>
    <label class="ml-check">
      <input type="checkbox" name="developerMode" {{checked developerMode}}>
      <span>Enable Developer Mode</span>
    </label>
    <label class="ml-stack" data-gap="1">
      <span>Test Subscription Level</span>
      <select name="developerTier">
        {{#each developerTiers}}
          <option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>
        {{/each}}
      </select>
      <small>Applies to all Morelord modules in this world while Developer Mode is enabled. Standard disables paid access everywhere. Higher levels remain capped by the connected account and each module's actual access.</small>
    </label>
    {{#if developerMode}}
      <p class="ml-status" data-tone="warning">Developer Mode is enabled for all Morelord modules. Subscription limit: {{effectiveTier}}. Reopen module windows after saving to update their displays.</p>
    {{/if}}
    <footer class="ml-page-footer ml-actions">
      <button type="button" data-action="saveSettings"><i class="fa-solid fa-floppy-disk"></i> Save Core Settings</button>
    </footer>
  </section>
</div>
