<section class="ml-app ml-app-shell ml-stack">
  <header class="ml-hero"><i class="fa-solid fa-circle-info ml-hero__icon" aria-hidden="true"></i><div class="ml-hero__body"><h1>{{title}}</h1><p>{{intro}}</p></div></header>
  <div class="ml-stack" data-gap="2">
    {{#each modules}}
    <article class="ml-card ml-item-row">
      <i class="{{icon}}" aria-hidden="true"></i>
      <div class="ml-stack" data-gap="1"><strong>{{title}}</strong><small class="notes">{{description}}</small></div>
      <span class="ml-status" data-tone="{{tone}}">{{statusLabel}}</span>
      {{#if url}}<a href="{{url}}" target="_blank" rel="noopener noreferrer" aria-label="{{learnMoreLabel}}">{{learnMore}}</a>{{/if}}
    </article>
    {{/each}}
  </div>
</section>
